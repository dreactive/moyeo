# Vercel build environment. Use your exact ngrok assigned dev domain, without /api.
# Free domains may end in .ngrok-free.dev or .ngrok-free.app; copy the displayed URL.
BACKEND_ORIGIN=https://your-assigned-name.ngrok-free.dev
# Public browser JavaScript key only; never put REST/Mobility/Apify/DEV tokens here.
KAKAO_JAVASCRIPT_KEY=
